SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Must exactly match a redirect URI in the Spotify developer dashboard.
# Local only: http://127.0.0.1:5001/auth/callback
# Behind the tunnel: https://party.example.com/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/auth/callback
# Seeds the host password (stored hashed). The app refuses to start on the default.
HOST_PASSWORD=choose_a_password
PARTY_URL=http://YOUR_LOCAL_IP:5001
# 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=choose_a_long_random_string
DOWNVOTE_THRESHOLD=7
MAX_QUEUE_PER_USER=2
SKIP_BAN_THRESHOLD=2
# Disposable camera film per guest per party (seeds the first run; host panel after that).
CAMERA_SHOTS_PER_GUEST=24
# Not 5000: macOS AirPlay Receiver owns that port.
PORT=5001
# Set to 1 only on a private machine to skip the unsafe-settings startup check.
JUKEBOX_DEV=0
